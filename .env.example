# Norinote environment. Copy to .env and fill in. Every variable is optional for local development:
# without DATABASE_URL the API and worker use an embedded PGlite database and an in-memory queue,
# and without OPENAI_API_KEY the ai package uses a deterministic fake model.

# Postgres 17 with pgvector. Unset = embedded PGlite under ./data/pglite.
DATABASE_URL=
# Embedded database location when DATABASE_URL is unset. Use :memory: for a throwaway database. (Default: ./data/pglite)
PGLITE_DIR=

# OpenAI key. Unset = fake provider (deterministic, no network, no cost).
OPENAI_API_KEY=
# Small model, used by default everywhere. (Default: gpt-4.1-mini)
AI_SMALL_MODEL=
# Large model, used only where a call names tier "large". (Default: gpt-4.1)
AI_LARGE_MODEL=
# Embedding model, must output 1536 dimensions. (Default: text-embedding-3-small)
EMBEDDING_MODEL=
# Per-user daily token budget across all model calls. 0 = unlimited. (Default: 300000)
AI_DAILY_TOKEN_BUDGET=

# Real submission only when "true". Otherwise applications are a dry run that fills the form and stops before submit.
ALLOW_REAL_SUBMIT=

# Domain that owned inbound addresses are created under (user-token@domain).
INBOUND_EMAIL_DOMAIN=
# Secret for inbound email webhooks: HMAC key for our Cloudflare Email Worker, basic-auth password for Postmark.
INBOUND_WEBHOOK_SECRET=
# Days inbound mail is kept (users may choose fewer). Default 90.
INBOX_RETENTION_DAYS=90

# Telegram bot token for the notification channel.
TELEGRAM_BOT_TOKEN=

# Public URL of the web app (used in links and CORS).
WEB_URL=
# Public URL of the landing site, which hosts sign-in and sign-up. Allowed in CORS, and account-email links point here.
LANDING_URL=
# Public URL of the API (used by the web app and webhooks).
API_URL=
# Account emails (verify address, reset password) through Resend. Both unset = printed to the console instead.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Norinote <hello@norinote.xyz>
MAIL_FROM=

# Secret used to sign sessions and tokens. Use a long random string.
SESSION_SECRET=

# Worker: parallel browser pages for applying (1 to 4). (Default: 3)
BROWSER_POOL_SIZE=
# Worker: job-understanding calls at once, so a backlog drains steadily. (Default: 4)
UNDERSTAND_CONCURRENCY=
# Worker: how often it looks for boards that are due, in minutes. (Default: 3)
SCHEDULE_EVERY_MINUTES=
# Worker: live boards queued per run (100), new candidates validated per run (50), boards of one host group per run (8).
BOARDS_PER_RUN=
VALIDATE_PER_RUN=
HOST_BOARDS_PER_RUN=
# Worker: polls at once per host group when the job system does not say (4; Workable is always 2), and in total (16).
POLLS_PER_HOST=
POLL_CONCURRENCY=
# Worker: how often the storage sweep trims jobs older than 72 hours that no user refers to, in minutes; 0 = off. (Default: 60)
JOB_SWEEP_EVERY_MINUTES=
# Worker: jobs per sweep batch, one short transaction each. (Default: 500)
JOB_SWEEP_BATCH=
# Worker: where resume PDFs and failure screenshots are written. (Default: ./data/artifacts)
ARTIFACTS_DIR=
# Object storage (S3 API) the generated files are also copied to, so the API can serve what the worker made on another
# machine. All four of endpoint, bucket and keys unset = local disk only. Supabase: https://<ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# API: port to listen on. (Default: 4000)
PORT=
# API: session cookie name; the web app must use the same. (Default: norinote_session)
SESSION_COOKIE_NAME=
# API: trust X-Forwarded-For for rate limits; set true behind Fly or another proxy. (Default: false)
TRUST_PROXY=
# Telegram bot username (without @), used in the t.me deep link. See docs/telegram.md.
TELEGRAM_BOT_USERNAME=
# Worker: how often the Telegram notifier runs, in seconds. (Default: 30)
TELEGRAM_TICK_SECONDS=
