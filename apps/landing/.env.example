# The site's own URL: link previews and canonical URLs. An https URL also turns on upgrade-insecure-requests.
NEXT_PUBLIC_SITE_URL=http://localhost:3400
# apps/api, called from the browser by sign-in and sign-up (auth-design-spec.md section 9). The API's WEB_URL must be
# this app's URL (http://localhost:3400 in development): its CORS, origin check and email links all use it.
NEXT_PUBLIC_API_URL=http://localhost:4000
